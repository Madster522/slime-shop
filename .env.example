# ============================================================
# SLIME SHOP — Environment Variables
# Copy this to .env.local and fill in your values
# ============================================================

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-node-e-require-crypto-randomBytes-32-toString-hex

# Google OAuth
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxx

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Square Payments
# Get from: https://developer.squareup.com/apps
# Use sandbox keys for development, production keys for live
NEXT_PUBLIC_SQUARE_APP_ID=sandbox-sq0idb-xxxxxxxxxx
NEXT_PUBLIC_SQUARE_LOCATION_ID=xxxxxxxxxxxxxxxxx
SQUARE_ACCESS_TOKEN=EAAAxxxxxxxxxxxxxxxxxx
# Set to 'sandbox' or 'production'
SQUARE_ENVIRONMENT=sandbox

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth redirect URI to add in Google Console:
# http://localhost:3000/api/auth/callback/google
